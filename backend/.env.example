# Copia este archivo como backend/.env y completa los valores.
# backend/.env está en .gitignore: las claves nunca se suben a GitHub.

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=""

# ── Stack actual ──────────────────────────────────────────────────────────────
# Gemini: la misma clave sirve para el stack actual y para Gemini 3.5 Flash-Lite
# (respaldo 2 del stack nuevo). Requiere facturación activa en el proyecto.
GOOGLE_API_KEY=""
# DeepSeek: respaldo actual del chat y evaluación principal del stack nuevo.
DEEPSEEK_API_KEY=""
# OpenAI: voz de salida (gpt-4o-mini-tts) y respaldo de voz de entrada.
OPENAI_API_KEY=""

# ── Stack nuevo (experimentacion/DeepSeek_Texto_imagenes) ─────────────────────
# MiniMax (plataforma internacional): chat principal.
MINIMAX_API_KEY=""
# Alibaba Cloud Model Studio, región internacional (Singapur): chat respaldo 1.
DASHSCOPE_API_KEY=""
# Groq: voz de entrada principal (Whisper Large v3 Turbo).
GROQ_API_KEY=""
# Z.ai: evaluación respaldo (GLM).
ZAI_API_KEY=""

# ── Autenticación JWT ─────────────────────────────────────────────────────────
SECRET_KEY=""
ADMIN_PASSWORD=""

# ── Seed ──────────────────────────────────────────────────────────────────────
SEED_PASSWORD_DEFAULT=""

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT="development"
